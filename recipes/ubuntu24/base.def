#DESC:Minimal Ubuntu 24.04 container root with bash, e2fsprogs and fuse2fs
#URL:https://hub.docker.com/_/ubuntu

Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox
    apt-get update
    apt-get install -y --no-install-recommends bash e2fsprogs fuse2fs
    rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99-no-sandbox
