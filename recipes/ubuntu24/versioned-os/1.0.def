#DESC:Versioned OS overlay used to test immutable OCI tags
#URL:https://packages.ubuntu.com/noble/tree

Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox
    apt-get update
    apt-get install -y --no-install-recommends tree
    tree --version
    rm -rf /var/lib/apt/lists/* /etc/apt/apt.conf.d/99-no-sandbox
