#DESC:Versioned OS overlay used to test immutable OCI tags
#URL:https://packages.ubuntu.com/noble/tree

Bootstrap: docker
From: ubuntu:24.04

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends tree
    tree --version
    apt-get clean
    rm -rf /var/lib/apt/lists/*
