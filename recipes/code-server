#!/usr/bin/env bash
#DESC:code-server {version}, VS Code in the browser
#URL:https://github.com/coder/code-server
#TARGET:code-server/{version}
#LICENSE:MIT
#REDISTRIBUTE:yes

#PH:version:4.137.0,4.136.2,4.135.0

#ENV:CODE_SERVER_HOME={prefix}   ## code-server {version} install directory

case "$(uname -m)" in
    x86_64)  arch=amd64 ;;
    aarch64) arch=arm64 ;;
    *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

cd "$CNT_TMP"
curl -fsSL -o code-server.tar.gz \
    "https://github.com/coder/code-server/releases/download/v{version}/code-server-{version}-linux-${arch}.tar.gz"
tar -xzf code-server.tar.gz -C "$CNT_PREFIX" --strip-components=1
